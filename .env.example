# ============================================
# fampay-verify — environment template
# Copy to .env and fill in your own values.
# ============================================

# --- Google OAuth (from Google Cloud Console) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/callback

# --- Cloudflare KV (Workers & Pages > KV) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_KV_NAMESPACE=your-kv-namespace-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# --- Base URL of your deployment ---
BASE_URL=https://your-domain.com

# --- Admin panel password (change this!) ---
ADMIN_PASSWORD=change-me-to-something-strong

# --- Support contact shown in the UI ---
SUPPORT_LINK=https://t.me/your_support

# --- QR API defaults (used by the client-side bot) ---
QR_API_URL=https://qr-api-vercel.vercel.app/qr
UPI_ID_DEFAULT=yourname@fam
BOT_NAME=YourBot
